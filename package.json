{
  "name": "discord-auto-advertiser",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --filter=@app/web",
    "dev:api": "turbo run dev --filter=@app/api",
    "dev:bot": "turbo run dev --filter=@app/bot",
    "dev:worker": "turbo run dev --filter=@app/worker",
    "build": "turbo run build",
    "start": "turbo run start --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:types": "bash tooling/scripts/gen-db-types.sh",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "key:rotate": "tsx tooling/scripts/rotate-token-key.ts",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,sql,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,sql,css}\""
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "tsx": "^4.19.1",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}