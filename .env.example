# ══════════════════════════════════════════════════════════════════════════
#  DISCORD AUTO-ADVERTISER — ENVIRONMENT CONTRACT
#  Copy to `.env` for local dev. Never commit real secrets.
# ══════════════════════════════════════════════════════════════════════════

# ─── Supabase ─────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# ⚠️  service_role bypasses RLS — used ONLY by api / bot / worker.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=super-long-random-jwt-secret

# ─── Discord OAuth (web login) ────────────────────────────────────────────
DISCORD_CLIENT_ID=1234567890123456789
DISCORD_CLIENT_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
DISCORD_OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback
DISCORD_GUILD_INVITE=https://discord.gg/your-invite-code

# ─── Discord Bot ──────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=MTIzNDU2Nzg5MDEyMzQ1Njc4OS5YWFhYWFgu...
DISCORD_GUILD_ID=1234567890123456789
DISCORD_ADMIN_ROLE_IDS=9876543210987654321
DISCORD_ADMIN_USER_IDS=

# ─── Crypto (32-byte base64 keys — generate with `openssl rand -base64 32`) ─
TOKEN_ENC_KEY_V1=
CODE_HASH_SECRET=
TOKEN_FP_SECRET=

# ─── Runtime ──────────────────────────────────────────────────────────────
NODE_ENV=development
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
WORKER_ID=worker-local-1
WORKER_POLL_MS=1000
WORKER_CONCURRENCY=10